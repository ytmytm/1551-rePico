	(text "Rotary encoder\n(KY-040)"
		(exclude_from_sim no)
		(at 34.163 186.309 0)
		(effects
			(font
				(size 1.016 1.016)
			)
		)
		(uuid "3a70b741-2221-4119-8c1d-5af16b0c04ea")
	)
	(text "NOTE: WPS can be disconnected from board and controled on daughterboard\nNOTE: DS0/DS1 not connected to pico, no way for unusual formats like SuperDOS?\n      (unless it's not needed at all for G64)\nNOTE: Phi2 NC onboard, AEC pulled up"
		(exclude_from_sim no)
		(at 353.06 121.158 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3db37429-6d02-496c-b6f5-6d9be8bd7c9f")
	)
	(text "NOTE: DEVNUM_3V3 - driven by Pico to choose device number, NOT connected to DEVNUM_BRD"
		(exclude_from_sim no)
		(at 547.116 91.948 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "76fd16a2-c13f-45eb-8a4b-0e4c277ee510")
	)
	(text "NOTE: no macrocells left to use CPLD for level shifting\nNOTE: all _3V3 signals are for Pico only, NOT for board\nNOTE: YB0..7 are for Pico only\nTODO: RESET_3V3, MODE_3V3, SYNC_3V3\n\nNOTE: XR/~{W} comes from GATE ARRAY, it is NOT CPU's R/~{W}\n      CPLD firmware can be later changed to use R/~{W} + Phi0/Phi2\n      without gate array\n\n"
		(exclude_from_sim no)
		(at 547.37 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8fdb0341-d972-4825-a3c6-42fc8bd9b712")
	)
	(text "NOTE: ACK/DAV naming reversed to keep the TCBM2SD connector intact\nNOTE: ACK here is controller's ACK output and goes to cable pin 13 (drive's DAV input)\nNOTE: DAV here is controller's DAV input and goes to cable pin 11 (drive's ACK output)\nNOTE: DEVNUM_BRD is shorted to GND onboard with hard to use J1 to be cut to pull it up\ncontrol it on daughterboard\nNOTE: ~{CS_TPI} is the signal we need to clear BYTE_LATCHED (aka TED from GATE ARRAY)\nNOTE: MODE==OE from GATE ARRAY"
		(exclude_from_sim no)
		(at 385.064 79.502 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "903710cc-dfcc-474d-81b3-e75b81795951")
	)
	(text "23x18mm\nSD Card module\n3.3v"
		(exclude_from_sim no)
		(at 15.24 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "95430e40-f253-429d-a7ed-2ba4fa54773b")
	)
	(text "no need to level shift these if they ONLY go to CPLD\nNOTE: YBx=PBx goes ONLY to CPLD can be disconnected from the board\nNOTE: same with MODE, SYNC from port C - but be sure about existing pullups/pulldowns"
		(exclude_from_sim no)
		(at 394.97 48.768 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bb5d49ba-a392-49cb-be3e-9cadd93ed963")
	)
	(text "Switch BOTH JP3/JP4\nfor VCC/GND/SCL/SDA\nor  GND/VCC/SCL/SDA\n"
		(exclude_from_sim no)
		(at 41.402 73.025 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "dcde9586-56be-4dcb-9450-512eff047867")
	)
