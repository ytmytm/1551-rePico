	)
	(text "Only open JP1 for WDC W65C02, not other 65C02.\n\nUsing a *65C02 will result in reduced software\ncompatibility due to CPU bugs fixed and\nundocumented opcodes altered, which are\nexploited by some software/games/demos."
		(exclude_from_sim no)
		(at 861.695 202.565 0)
