	(text "Required b/c depending on tcbm2sd version\n~{RESET} can be pulled to 5V or 3.3V\nuse BAT54, BAS40, BAT43, 1n5819 as D2"
		(exclude_from_sim no)
		(at 127.254 130.556 0)
