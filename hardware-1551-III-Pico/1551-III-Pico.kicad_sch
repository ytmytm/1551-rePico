		(uuid "2e3e82d6-0cef-4544-b334-daf4326212fe")
	)
	(text "all of these TAP_xxx -> CAS_xxx and CAS_xxx -> TAP_xxx\nconverters reverse the logic levels\nall transistors are NPN:\n2n3904 / BC547 / S8050 / etc.\n\nNote: SMD transistors have different pinouts\nTHT: B on 2 and E on 1 (EBC) (2N3904)\nSMD: B on 1 and E on 2 (BEC) (MMBT3904 also sold as 2n3904)"
		(exclude_from_sim no)
		(at 339.09 100.457 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "34a463ff-1ef0-452c-9abe-aef5923a37f7")
	)
