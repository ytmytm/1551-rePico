	)
	(text "NOTE: ACK/DAV naming reversed to keep the TCBM2SD connector intact\nNOTE: ACK here is controller's ACK output and goes to cable pin 13 (drive's DAV input)\nNOTE: DAV here is controller's DAV input and goes to cable pin 11 (drive's ACK output)\nNOTE: ~{CS_TPI} is the signal we need to clear BYTE_LATCHED (aka TED from GATE ARRAY)\nNOTE: MODE==OE from GATE ARRAY"
		(exclude_from_sim no)
		(at 330.454 68.834 0)
		(effects
